# --- App ---
APP_NAME=CREST API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# --- Frontend (trusted CORS origins) ---
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crest
DB_PASSWORD=crest_secret
DB_NAME=crest

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-please-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CONTACT=5/minute

# --- Cookies / secure headers ---
COOKIE_SECURE=false
